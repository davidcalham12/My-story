{
  "_comment": "Merged config for this run: config/novel.config.json with config/profiles/eval.json overlaid key by key. The bible block is the profile's entire block, per CFG-2a.",
  "_comment_privacy": "The recipient's name is NOT written by any model. Under the organisation's data-protection policy and docs/spec.md §8 (decision of 2026-09-24), every prompt and every generated file carries the token [NOMBRE_ANONIMIZADO] where the recipient's name goes; backend/publish/personalise.py substitutes the alias from the brief at publication.",
  "profile": "eval",
  "slug": "finisterre-lighthouse-retirement",
  "novel": {
    "chapters": 1,
    "tone": "warm literary fiction, a life looked back on — coastal, domestic, gently elegiac, with a working man's plain competence at its centre; no magic, no mystery-thriller machinery, no science fiction",
    "names": "familiar",
    "author": "NovaForge",
    "language": "en",
    "words_per_chapter": { "min": 300, "target": 420, "max": 550 },
    "tolerance_pct": 25,
    "paragraphs_per_chapter": { "min": 5, "max": 24 },
    "sentences_per_paragraph": { "min": 1, "max": 5 },
    "lines_per_chapter": { "min": 25, "max": 95 },
    "chars_per_line": { "max": 64 },
    "beats_per_chapter": { "min": 3, "max": 5 },
    "promises": { "min": 3, "max": 5 }
  },
  "bible": {
    "world_min_words": 500,
    "world_max_words": 900,
    "technology_entries": { "min": 4, "max": 6 },
    "factions": { "min": 3, "max": 4 },
    "world_rules": { "min": 5, "max": 8 },
    "characters": { "min": 5, "max": 7 },
    "timeline_rows": { "min": 10, "max": 14 },
    "mysteries": { "min": 4, "max": 5 }
  },
  "context": {
    "max_summary_words": 120,
    "forbid_prior_chapter_prose": true,
    "max_concurrent_tokens": 100000,
