  "budget": { "max_cost_usd": 25.0, "max_calls": 200 },
  "outputs": {
    "formats": ["markdown"],
    "synopsis": { "words": { "min": 150, "max": 250 }, "comparables": { "min": 2, "max": 3 } },
    "markdown": {
      "filename": "book.md",
      "single_file": true,
      "include_bible_appendix": false,
      "include_synopsis": true
    }
  },
  "word_band_applied": { "min": 225, "max": 688, "note": "words_per_chapter.min/max widened by tolerance_pct 25" }
