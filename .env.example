# Copy to .env and fill in. Never commit the filled file.
# There is no Anthropic API key: the only access to a model is the owner's Claude Code session.

# Langfuse (observability). The project is in the US region; the SDK defaults to the EU.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Backend
USE_RECORDED_STREAM=true      # false to orchestrate for real (costs the subscription)
NOVAFORGE_DB=./novaforge.db
NOVAFORGE_BUDGET=             # optional; can only lower the profile's ceiling
